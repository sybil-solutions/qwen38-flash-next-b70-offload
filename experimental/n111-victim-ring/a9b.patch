+// a9b (N111): victim-ring drain worker. A native thread with its own in-order queue copies ring slots to their RAM-tier
+// (pageable memfd) addresses: a D2H memcpy into pageable memory can block the submitting thread for the whole copy, so
+// the Python step only pushes jobs (no GIL held while copying) and later reads the completed sequence number.
+struct VrDrain {
+    sycl::queue q;
+    std::thread th; std::mutex mu; std::condition_variable cv;
+    std::deque<std::array<int64_t, 4>> jobs;   // src, dst, nbytes, seq
+    std::atomic<int64_t> done{0}; bool stop = false;
+    explicit VrDrain(sycl::queue q0) : q(q0.get_context(), q0.get_device(), sycl::property::queue::in_order()) {}
+    void run() {
+        std::vector<std::array<int64_t, 4>> batch;
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lk(mu);
+                cv.wait(lk, [&] { return stop || !jobs.empty(); });
+                if (jobs.empty()) return;
+                batch.assign(jobs.begin(), jobs.end()); jobs.clear();
+            }
+            for (auto& j : batch) q.memcpy(reinterpret_cast<void*>(j[1]), reinterpret_cast<const void*>(j[0]), (size_t)j[2]);
+            q.wait();
+            done.store(batch.back()[3], std::memory_order_release);
+        }
+    }
+};
+static std::unique_ptr<VrDrain> g_vrd; static int64_t g_vrd_seq = 0;
+int64_t moe_vring_drain_push(int64_t src, int64_t dst, int64_t nbytes) {
+    if (!g_vrd) {
+        g_vrd = std::make_unique<VrDrain>(c10::xpu::getCurrentXPUStream().queue());
+        g_vrd->th = std::thread([p = g_vrd.get()] { p->run(); });
+    }
+    int64_t sq = ++g_vrd_seq;
+    { std::lock_guard<std::mutex> lk(g_vrd->mu); g_vrd->jobs.push_back({src, dst, nbytes, sq}); }
+    g_vrd->cv.notify_one();
+    return sq;
+}
+int64_t moe_vring_drain_done() { return g_vrd ? g_vrd->done.load(std::memory_order_acquire) : 0; }
+int64_t moe_vring_drain_stop() {
+    if (!g_vrd) return 0;
+    { std::lock_guard<std::mutex> lk(g_vrd->mu); g_vrd->stop = true; }
+    g_vrd->cv.notify_one(); g_vrd->th.join();
+    int64_t d = g_vrd->done.load(); g_vrd.reset(); return d;
+}
